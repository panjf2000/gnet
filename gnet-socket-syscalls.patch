+
+//go:build darwin || dragonfly || freebsd || netbsd || openbsd
+
+package io
+
+// The socket-specific entry points fall back to the existing BSD read/write
+// wrappers. The recvfrom/sendto experiment is Linux-only; this keeps the Unix
+// event-loop call sites portable and leaves BSD behavior unchanged.
+func ReadSocketNB(fd int, p []byte) (int, error)  { return ReadNB(fd, p) }
+func WriteSocketNB(fd int, p []byte) (int, error) { return WriteNB(fd, p) }
diff --git a/pkg/io/io_socket_linux_test.go b/pkg/io/io_socket_linux_test.go
new file mode 100644
index 0000000..1e143bd
--- /dev/null
+++ b/pkg/io/io_socket_linux_test.go
@@ -0,0 +1,118 @@
+// Copyright (c) 2025 The Gnet Authors. All rights reserved.
+//
+// Licensed under the Apache License, Version 2.0 (the "License");
+// you may not use this file except in compliance with the License.
+// You may obtain a copy of the License at
